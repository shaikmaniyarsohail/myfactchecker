{
  "name": "myfactchecker-server",
  "version": "1.0.0",
  "description": "Free-API fact-checking backend for YouTube video claims",
  "license": "MIT",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test",
    "stop": "ss -ltnp 'sport = :8787' 2>/dev/null | grep -o 'pid=[0-9]*' | cut -d= -f2 | xargs -r kill",
    "restart": "npm run stop && npm start"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  }
}
